{
  "appId": "com.sevenz.app",
  "appName": "Sevenz",
  "webDir": "www",
  "backgroundColor": "#080C12",
  "android": {
    "backgroundColor": "#080C12",
    "allowMixedContent": true
  },
  "ios": {
    "backgroundColor": "#080C12",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#080C12"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT",
      "hidden": false,
      "animation": "NONE"
    },
    "KeepAwake": {},
    "AudioPlayer": {},
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
