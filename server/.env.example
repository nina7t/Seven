# Copier ce fichier en .env et ajouter votre clé API YouTube
YOUTUBE_API_KEY=VOTRE_CLE_API_YOUTUBE_ICI
# Clés supplémentaires optionnelles (rotation quota)
# YOUTUBE_API_KEY_2=
# YOUTUBE_API_KEY_3=
PORT=3001
# Token requis pour la route admin /api/admin/clear-cache (laisser vide = route désactivée)
ADMIN_TOKEN=
# Clé Last.fm pour les recommandations d'artistes similaires
# Créer une clé sur https://www.last.fm/api/account/create (instantané)
# Si vide, les features de découverte se désactivent silencieusement.
LASTFM_API_KEY=

# Credentials Spotify pour l'import de playlists
# Créer une app sur https://developer.spotify.com/dashboard/applications
# Redirect URI à ajouter dans le dashboard : http://localhost:3001/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/spotify/callback

# Credentials TIDAL pour le module Découverte et le lecteur haute qualité (Phase 2)
# Créer une app sur https://developer.tidal.com
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# ── Extraction audio (yt-dlp) ────────────────────────────────────────────────
# Depuis une IP d'hebergeur, YouTube repond « Sign in to confirm you're not a
# bot » sur la quasi-totalite des clips. Fournir des cookies YouTube est le seul
# contournement fiable. Exporter un cookies.txt (format Netscape) depuis un
# navigateur connecte, puis AU CHOIX :
#   - YTDLP_COOKIES_FILE : chemin absolu vers ce fichier sur le serveur
#   - YTDLP_COOKIES_B64  : le fichier encode en base64 (`base64 -i cookies.txt`)
# Utiliser de preference un compte YouTube dedie, jamais un compte personnel.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=

# Client YouTube alternatif pour yt-dlp (ios, web_safari, android_vr, tv...).
# Vide = client par defaut. A n'utiliser que pour deboguer un blocage.
YTDLP_PLAYER_CLIENT=

# Instances Invidious, separees par des virgules. VIDE par defaut : au 18/09/2026
# aucune instance publique ne repond (16 testees). Renseigner uniquement si
# l'ecosysteme redevient utilisable.
INVIDIOUS_INSTANCES=
INVIDIOUS_TIMEOUT_MS=6000

# visitor_data YouTube : aide yt-dlp a obtenir un PO Token GVS. Sans PO Token,
# YouTube ne sert que le premier Mio de chaque URL audio (~1 min de son) puis
# repond 403 — constate le 18/09/2026.
YTDLP_VISITOR_DATA=

# Runtime JS utilise par yt-dlp (node par defaut, deno/bun possibles).
YTDLP_JS_RUNTIME=node
