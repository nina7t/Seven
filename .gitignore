# Fichiers de configuration avec clés API — ne jamais commiter
config.js
server/.env
.env

# Dépendances
node_modules/
server/node_modules/

# Firebase
.firebase/

# Exception : constantes du moteur de découverte, aucune clé dedans
!server/discovery/config.js

# État runtime du quota YouTube
server/.quota.json

# Binaires de build mobile — ne jamais commiter
*.apk
*.ipa
*.dylib

# Fichiers de config locale Android
android/local.properties

# Fichiers sensibles iOS
ios/App/App/GoogleService-Info.plist

# Outils de développement IA
.opencode/

# Fichiers macOS
.DS_Store
